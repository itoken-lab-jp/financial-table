    "powerbi-visuals-utils-formattingmodel": "6.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "powerbi-visuals-tools": "7.2.1",
    "typescript": "5.5.4"
  }
